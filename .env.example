# ==============================================================================
# WedSnap - Environment Configuration (.env)
# ==============================================================================

# Application Environment ('development' | 'production')
ENVIRONMENT=production

# High-Entropy Secret Key for JWT admin tokens & signed downloads
SECRET_KEY=generate-a-strong-32-character-random-secret-key-here

# Supabase Managed Cloud Database (PostgreSQL with pgvector)
# Example: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_supabase_db_password@db.your_project_ref.supabase.co:5432/postgres

# Supabase Storage & Managed Services (Optional: omit to use resilient disk storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET_ORIGINAL=wedding-photos-original
SUPABASE_STORAGE_BUCKET_THUMBNAILS=wedding-photos-thumbnails

# Frontend Public Base URL (Used for generating live QR codes and table display cards)
FRONTEND_BASE_URL=https://your-wedding-gallery.vercel.app

# CORS Allowed Origins (Comma-separated or list)
CORS_ORIGINS=["https://your-wedding-gallery.vercel.app", "http://localhost:5173"]

# Facial Recognition Settings
FACE_SIMILARITY_THRESHOLD=0.58
FACE_DETECTION_CONFIDENCE=0.80

# Cloud Server Port (Set automatically by Render/Railway/Cloud Run)
PORT=8000
